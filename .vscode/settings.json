{
  "dart.flutterSdkPath": ".fvm/versions/3.35.6",
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.rulers": [
    80
  ],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit"
  },
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/.fvm": true,
    "**/.idea": true,
    "**/.vscode": true,
    "**/*.freezed.dart": true,
    "**/*.g.dart": true,
    "**/*.gr.dart": true
  },
  "search.exclude": {
    "**/build": true,
    "**/.dart_tool": true,
    "**/*.g.dart": true,
    "**/*.freezed.dart": true,
    "**/*.gr.dart": true,
    "**/ios/Pods": true,
    "**/ios/Flutter/App.framework": true,
    "**/.pub-cache": true,
    "pubspec.lock": true
  },
  "bloc.newBlocTemplate.type": "equatable",
  "bloc.newCubitTemplate.type": "equatable",
  "dart.previewFlutterUiGuides": true,
  "dart.lineLength": 80
}